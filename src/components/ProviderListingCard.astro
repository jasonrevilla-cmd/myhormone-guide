---
import { maskPhone } from '../lib/providerMasking';

interface Props {
  slug: string;
  practiceName: string;
  city: string;
  stateAbbr: string;
  phone: string;
  status: string;
}

const { slug, practiceName, city, stateAbbr, phone, status } = Astro.props;
const isUnclaimed = status === 'unclaimed';

const displayPhone = isUnclaimed ? maskPhone(phone) : phone;
---

<div class="bg-white border border-navy-100 rounded-2xl p-6 hover:border-teal-300 hover:shadow-sm transition-all duration-200">
  <div class="flex items-start justify-between gap-3 flex-wrap mb-3">
    <div>
      <h3 class="font-semibold text-navy-700">
        <a href={`/provider/${slug}/`} class="hover:text-teal-600 transition-colors">{practiceName}</a>
      </h3>
      <p class="text-sm text-gray-400 mt-0.5">{city}, {stateAbbr}</p>
    </div>
    {isUnclaimed && (
      <span class="inline-flex items-center bg-amber-50 text-amber-700 text-xs font-semibold px-3 py-1 rounded-full whitespace-nowrap">
        Unclaimed listing
      </span>
    )}
  </div>

  <span class="inline-flex items-center gap-1.5 bg-teal-50 text-teal-700 text-xs font-semibold px-3 py-1 rounded-full mb-4">
    <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
    </svg>
    EvexiPEL certified
  </span>

  <div class="flex items-center justify-between gap-3 flex-wrap pt-4 border-t border-navy-50">
    <div class="flex items-center gap-2 text-sm text-gray-400">
      <svg class="w-4 h-4 text-navy-300 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
      </svg>
      <span class="blur-[3px] select-none">{displayPhone}</span>
    </div>
    <a
      href="/claim-your-listing/"
      class="inline-flex items-center gap-1.5 bg-navy-600 hover:bg-navy-700 text-white text-xs font-semibold px-4 py-2 rounded-full transition-colors whitespace-nowrap"
    >
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
      </svg>
      Claim This Listing
    </a>
  </div>
</div>
