---
// Renders the GHL "Message This Provider" form. The iframe src must be built
// per-page — GHL's form sandboxing means a static src can't receive the
// provider context, so we pass it via query params on hidden form fields
// (provider_slug/provider_state/provider_city/provider_name) instead.
interface Props {
  slug: string;
  name: string;
  city: string;
  stateCode: string;
}

const { slug, name, city, stateCode } = Astro.props;

const GHL_FORM_ID = 'vJPuQETjr9qGdIMzBbJL';
const GHL_FORM_BASE_URL = `https://api.leadconnectorhq.com/widget/form/${GHL_FORM_ID}`;

const formSrc = `${GHL_FORM_BASE_URL}?${new URLSearchParams({
  provider_slug: slug,
  provider_state: stateCode,
  provider_city: city,
  provider_name: name,
})}`;
---

<section aria-labelledby="inquiry-heading" class="mb-10 bg-white border border-navy-100 rounded-2xl p-6">
  <h2 id="inquiry-heading" class="text-lg font-bold text-navy-700 mb-4">Message This Provider</h2>
  <div class="relative">
    <div id="inquiry-form-skeleton" class="absolute inset-0 space-y-4 animate-pulse" aria-hidden="true">
      <div class="h-11 bg-navy-50 rounded-lg"></div>
      <div class="h-11 bg-navy-50 rounded-lg"></div>
      <div class="h-11 bg-navy-50 rounded-lg"></div>
      <div class="h-11 bg-navy-50 rounded-lg"></div>
      <div class="h-28 bg-navy-50 rounded-lg"></div>
      <div class="h-11 w-40 bg-navy-100 rounded-full"></div>
    </div>
    <iframe
      src={formSrc}
      style="width:100%;height:1340px;border:none;border-radius:8px"
      class="relative opacity-0 transition-opacity duration-300"
      id={`inline-${GHL_FORM_ID}`}
      data-layout="{'id':'INLINE'}"
      data-trigger-type="alwaysShow"
      data-trigger-value=""
      data-activation-type="alwaysActivated"
      data-activation-value=""
      data-deactivation-type="neverDeactivate"
      data-deactivation-value=""
      data-form-name="Form 0"
      data-height="1340"
      data-layout-iframe-id={`inline-${GHL_FORM_ID}`}
      data-form-id={GHL_FORM_ID}
      title={`Message ${name}`}
    ></iframe>
  </div>
</section>

<script src="https://link.msgsndr.com/js/form_embed.js" is:inline></script>
<script define:vars={{ iframeId: `inline-${GHL_FORM_ID}` }} is:inline>
  // The iframe's cross-origin `load` fires once GHL's document has loaded —
  // close enough to "form visible" to swap out the skeleton without needing
  // to read into the frame (which we can't, cross-origin).
  document.getElementById(iframeId)?.addEventListener('load', function () {
    this.classList.remove('opacity-0');
    document.getElementById('inquiry-form-skeleton')?.remove();
    // The wrapper's min-height only exists to reserve space for the skeleton
    // above so the page doesn't jump when it's removed. GHL's form_embed.js
    // resizes the iframe itself to its real content height via postMessage,
    // but never touches our wrapper — leaving it pinned at 1340px and a dead
    // gap below a shorter iframe. Once the real form has taken over, let the
    // wrapper size itself off the iframe's (live-updated) height instead.
    const wrapper = this.closest('.relative');
    if (wrapper) wrapper.style.minHeight = '0';
  });
</script>
