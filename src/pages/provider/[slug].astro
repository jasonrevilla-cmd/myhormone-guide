---
import citiesData from '../../data/cities.json';
import providersData from '../../../providers.json';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProviderClaimModal from '../../components/ProviderClaimModal.astro';
import { maskPhone, maskStreet } from '../../lib/providerMasking';

export function getStaticPaths() {
  return providersData.map((provider) => ({
    params: { slug: provider.slug },
    props: { provider },
  }));
}

interface Props {
  provider: (typeof providersData)[0];
}

const { provider } = Astro.props;
const isUnclaimed = provider.status === 'unclaimed';

const SITE_URL = 'https://www.myhormoneguide.com';
const pageUrl = `${SITE_URL}/provider/${provider.slug}/`;

const displayPhone = isUnclaimed ? maskPhone(provider.phone) : provider.phone;
const displayStreet = isUnclaimed ? maskStreet(provider.street) : provider.street;

// Only link into the curated city/state tree if this provider's city is
// actually one of the curated pages — otherwise the breadcrumb would point
// to a page that exists but doesn't list this provider, or worse, nowhere.
const matchedState = citiesData.states.find((s) => s.abbr === provider.stateCode);
const matchedCity = matchedState?.cities.find(
  (c) => c.name.trim().toLowerCase() === provider.city.trim().toLowerCase()
);

const providerHref = `/provider/${provider.slug}/`;

const breadcrumbs = [
  { label: 'Find a Provider', href: '/find-bhrt-provider/' },
  ...(matchedState ? [{ label: matchedState.name, href: `/find-bhrt-provider/${matchedState.slug}/` }] : []),
  ...(matchedState && matchedCity
    ? [{ label: matchedCity.name, href: `/find-bhrt-provider/${matchedState.slug}/${matchedCity.slug}/` }]
    : []),
  { label: provider.practiceName, href: providerHref },
];

const metaTitle = `${provider.practiceName} — BHRT Provider in ${provider.city}, ${provider.stateCode}`;
const metaDescription = `${provider.practiceName} is an EvexiPEL-certified BHRT provider in ${provider.city}, ${provider.stateCode}. View services, certifications, and contact information.`;

// LocalBusiness schema omits telephone/streetAddress for unclaimed listings —
// structured data is machine-readable, so masking it visually but not here
// would leak the real contact info to any crawler/scraper reading the page source.
const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'MedicalBusiness',
  name: provider.practiceName,
  url: pageUrl,
  address: {
    '@type': 'PostalAddress',
    ...(isUnclaimed ? {} : { streetAddress: provider.street }),
    addressLocality: provider.city,
    addressRegion: provider.stateCode,
    postalCode: provider.zip,
    addressCountry: 'US',
  },
  ...(isUnclaimed ? {} : { telephone: provider.phone }),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((crumb, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: crumb.label,
    item: crumb.href.startsWith('http') ? crumb.href : `${SITE_URL}${crumb.href}`,
  })),
};
---

<BaseLayout
  title={metaTitle}
  description={metaDescription}
  canonicalUrl={pageUrl}
  breadcrumbs={breadcrumbs}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <!-- Header -->
  <div class="bg-gradient-to-br from-navy-600 to-navy-700 py-14">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-2 flex-wrap mb-4">
        <span class="inline-flex items-center gap-1.5 bg-teal-400/20 text-teal-200 text-sm px-3 py-1 rounded-full">
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          EvexiPEL certified
        </span>
        {isUnclaimed && (
          <span class="inline-flex items-center bg-amber-400/20 text-amber-200 text-sm font-semibold px-3 py-1 rounded-full">
            Unclaimed listing
          </span>
        )}
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white mb-3">
        {provider.practiceName}
      </h1>
      <p class="text-navy-100 text-lg">{provider.city}, {provider.stateCode}</p>
    </div>
  </div>

  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

    <!-- Contact info -->
    <section aria-labelledby="contact-heading" class="mb-10 bg-white border border-navy-100 rounded-2xl p-6">
      <h2 id="contact-heading" class="text-lg font-bold text-navy-700 mb-4">Contact Information</h2>
      <div class="space-y-4">
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-navy-300 flex-shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
          <div>
            {isUnclaimed && (
              <svg class="w-3.5 h-3.5 text-navy-300 inline mr-1.5 -mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
              </svg>
            )}
            <span class:list={["text-navy-700", { "blur-[3px] select-none": isUnclaimed }]}>
              {displayStreet && `${displayStreet}, `}{provider.city}, {provider.stateCode} {provider.zip}
            </span>
          </div>
        </div>
        <div class="flex items-center gap-3">
          <svg class="w-5 h-5 text-navy-300 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
          </svg>
          {isUnclaimed && (
            <svg class="w-3.5 h-3.5 text-navy-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
            </svg>
          )}
          <span class:list={["text-navy-700", { "blur-[3px] select-none": isUnclaimed }]}>{displayPhone}</span>
        </div>
        {(provider.evexipelProfileUrl || provider.googleBusinessUrl) && (
          <div class="flex items-center gap-4 flex-wrap pt-2">
            {provider.evexipelProfileUrl && (
              <a href={provider.evexipelProfileUrl} target="_blank" rel="noopener noreferrer nofollow" class="inline-flex items-center gap-1.5 text-sm font-medium text-teal-600 hover:text-teal-500">
                View EvexiPEL Profile
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                </svg>
              </a>
            )}
            {provider.googleBusinessUrl && (
              <a href={provider.googleBusinessUrl} target="_blank" rel="noopener noreferrer nofollow" class="inline-flex items-center gap-1.5 text-sm font-medium text-teal-600 hover:text-teal-500">
                View on Google
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                </svg>
              </a>
            )}
          </div>
        )}
      </div>
    </section>

    <!-- Certifications & services -->
    <section aria-labelledby="services-heading" class="mb-10 grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="bg-white border border-navy-100 rounded-2xl p-6">
        <h2 class="text-sm font-semibold text-navy-500 uppercase tracking-wide mb-3">Certifications</h2>
        <ul class="space-y-2">
          {provider.certifications.map((cert) => (
            <li class="flex items-center gap-2 text-sm text-navy-700">
              <svg class="w-4 h-4 text-teal-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              {cert}
            </li>
          ))}
        </ul>
      </div>
      <div class="bg-white border border-navy-100 rounded-2xl p-6">
        <h2 id="services-heading" class="text-sm font-semibold text-navy-500 uppercase tracking-wide mb-3">Services</h2>
        <ul class="space-y-2">
          {provider.services.map((service) => (
            <li class="flex items-center gap-2 text-sm text-navy-700">
              <svg class="w-4 h-4 text-teal-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              {service}
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Unlock CTA -->
    {isUnclaimed && (
      <section class="mb-10 bg-navy-50 border border-navy-100 rounded-2xl p-8 text-center">
        <svg class="w-10 h-10 text-navy-400 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
        </svg>
        <h2 class="text-xl font-bold text-navy-700 mb-2">This is an unclaimed listing</h2>
        <p class="text-gray-600 mb-6 max-w-md mx-auto">
          Full contact details are hidden until this practice claims and unlocks its profile.
        </p>
        <button
          type="button"
          class="unlock-profile-btn inline-flex items-center gap-2 bg-navy-600 hover:bg-navy-700 text-white font-semibold px-6 py-3 rounded-full transition-colors"
        >
          Unlock This Profile — $9.99/mo
        </button>
      </section>
    )}

    <!-- Claim modal -->
    <div id="claim">
      <ProviderClaimModal cityName={provider.city} stateName={matchedState?.name ?? provider.stateCode} stateAbbr={provider.stateCode} />
    </div>

  </div>
</BaseLayout>

<script>
  document.querySelectorAll('.unlock-profile-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const openBtn = document.getElementById('open-claim-modal');
      if (openBtn) {
        (openBtn as HTMLElement).click();
      } else {
        document.getElementById('claim')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  });
</script>
