---
// Client-side "nearest providers" search. Ships two static JSON assets
// (public/data/zip-coords.json, public/data/providers-geo.json — generated by
// scripts/geocode-providers.cjs) and does the zip lookup + haversine distance
// entirely in the browser, since this is a static site with no per-request
// server compute. Result cards mirror ProviderListingCard.astro's exact
// markup/classes (including the same maskPhone masking) so the unclaimed-
// listing gating displays identically — Astro components can't be invoked
// from client JS on a static build, so this is a JS port of that template
// rather than a re-import of the component. "Claim This Listing" is a plain
// link to /claim-your-listing/, same as the Astro component's version.
---

<section id="zip-search" aria-labelledby="zip-search-heading" class="mb-14 bg-navy-50 border border-navy-100 rounded-2xl p-6 sm:p-8">
  <h2 id="zip-search-heading" class="text-xl font-bold text-navy-700 mb-2">Find Providers Near You</h2>
  <p class="text-sm text-gray-500 mb-5">
    Enter your ZIP code to see the closest BHRT providers, nearest first.
  </p>

  <form id="zip-search-form" class="flex flex-col sm:flex-row gap-3">
    <input
      type="text"
      inputmode="numeric"
      pattern="[0-9]{5}"
      maxlength="5"
      id="zip-input"
      name="zip"
      placeholder="Enter ZIP code"
      required
      class="flex-1 border-2 border-navy-100 rounded-full px-4 py-3 text-sm focus:border-teal-400 focus:outline-none"
    />
    <select
      id="cert-filter"
      name="certification"
      class="border-2 border-navy-100 rounded-full px-4 py-3 text-sm focus:border-teal-400 focus:outline-none bg-white"
    >
      <option value="">All certifications</option>
      <option value="EvexiPEL">EvexiPEL</option>
      <option value="BioTE">BioTE</option>
    </select>
    <button
      type="submit"
      id="zip-search-btn"
      class="bg-teal-400 hover:bg-teal-500 text-white font-semibold text-sm px-6 py-3 rounded-full transition-colors whitespace-nowrap disabled:opacity-60"
    >
      Search
    </button>
  </form>

  <p id="zip-search-error" class="hidden text-sm text-red-600 bg-red-50 border border-red-100 rounded-lg px-4 py-3 mt-4"></p>

  <div id="zip-search-results" class="mt-6"></div>
</section>

<script>
  import { maskPhone } from '../lib/providerMasking';

  interface ProviderGeo {
    slug: string;
    practiceName: string;
    city: string;
    stateCode: string;
    phone: string;
    status: string;
    certifications: string[];
    lat: number;
    lng: number;
  }

  const RESULT_COUNT = 20;

  const form = document.getElementById('zip-search-form') as HTMLFormElement;
  const input = document.getElementById('zip-input') as HTMLInputElement;
  const certFilter = document.getElementById('cert-filter') as HTMLSelectElement;
  const errorEl = document.getElementById('zip-search-error') as HTMLElement;
  const resultsEl = document.getElementById('zip-search-results') as HTMLElement;
  const btn = document.getElementById('zip-search-btn') as HTMLButtonElement;

  let zipCoords: Record<string, [number, number]> | null = null;
  let providers: ProviderGeo[] | null = null;
  let lastSearchedZip: string | null = null;

  function haversineMiles(lat1: number, lon1: number, lat2: number, lon2: number): number {
    const R = 3958.8; // Earth radius in miles
    const toRad = (d: number) => (d * Math.PI) / 180;
    const dLat = toRad(lat2 - lat1);
    const dLon = toRad(lon2 - lon1);
    const a =
      Math.sin(dLat / 2) ** 2 +
      Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) * Math.sin(dLon / 2) ** 2;
    return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
  }

  // Mirrors ProviderListingCard.astro's markup exactly, with a distance label
  // added to the city/state line.
  function renderCard(provider: ProviderGeo, distanceMiles: number): string {
    const isUnclaimed = provider.status === 'unclaimed';
    const displayPhone = isUnclaimed ? maskPhone(provider.phone) : provider.phone;

    return `
      <div class="bg-white border border-navy-100 rounded-2xl p-6 hover:border-teal-300 hover:shadow-sm transition-all duration-200">
        <div class="flex items-start justify-between gap-3 flex-wrap mb-3">
          <div>
            <h3 class="font-semibold text-navy-700">
              <a href="/provider/${provider.slug}/" class="hover:text-teal-600 transition-colors">${provider.practiceName}</a>
            </h3>
            <p class="text-sm text-gray-400 mt-0.5">${provider.city}, ${provider.stateCode} · ${distanceMiles.toFixed(1)} mi away</p>
          </div>
          ${isUnclaimed ? `<span class="inline-flex items-center bg-amber-50 text-amber-700 text-xs font-semibold px-3 py-1 rounded-full whitespace-nowrap">Unclaimed listing</span>` : ''}
        </div>

        <div class="flex flex-wrap gap-2 mb-4">
          ${provider.certifications.map((cert) => `
            <span class="inline-flex items-center gap-1.5 bg-teal-50 text-teal-700 text-xs font-semibold px-3 py-1 rounded-full">
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              ${cert} certified
            </span>
          `).join('')}
        </div>

        <div class="flex items-center justify-between gap-3 flex-wrap pt-4 border-t border-navy-50">
          <div class="flex items-center gap-2 text-sm text-gray-400">
            <svg class="w-4 h-4 text-navy-300 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
            </svg>
            <span class="blur-[3px] select-none">${displayPhone}</span>
          </div>
          <a href="/claim-your-listing/" class="inline-flex items-center gap-1.5 bg-navy-600 hover:bg-navy-700 text-white text-xs font-semibold px-4 py-2 rounded-full transition-colors whitespace-nowrap">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
            </svg>
            Claim This Listing
          </a>
        </div>
      </div>
    `;
  }

  async function ensureDataLoaded() {
    if (!zipCoords) {
      const res = await fetch('/data/zip-coords.json');
      zipCoords = await res.json();
    }
    if (!providers) {
      const res = await fetch('/data/providers-geo.json');
      providers = await res.json();
    }
  }

  function showError(message: string) {
    errorEl.textContent = message;
    errorEl.classList.remove('hidden');
    resultsEl.innerHTML = '';
  }

  async function runSearch(zip: string) {
    errorEl.classList.add('hidden');

    btn.disabled = true;
    const originalLabel = btn.textContent;
    btn.textContent = 'Searching…';

    try {
      await ensureDataLoaded();

      const coords = zipCoords?.[zip];
      if (!coords) {
        showError(`We couldn't find ZIP code "${zip}". Double-check it and try again.`);
        return;
      }
      if (!providers) {
        showError('Something went wrong loading provider data. Please try again.');
        return;
      }

      const cert = certFilter.value;
      const eligible = cert ? providers.filter((p) => p.certifications.includes(cert)) : providers;

      const [lat, lng] = coords;
      const nearest = eligible
        .map((provider) => ({ provider, distance: haversineMiles(lat, lng, provider.lat, provider.lng) }))
        .sort((a, b) => a.distance - b.distance)
        .slice(0, RESULT_COUNT);

      lastSearchedZip = zip;

      if (nearest.length === 0) {
        resultsEl.innerHTML = `<p class="text-sm text-gray-500">No ${cert ? cert + '-certified ' : ''}providers found near ${zip}. Try a different certification filter.</p>`;
        return;
      }

      resultsEl.innerHTML = `
        <p class="text-sm text-gray-500 mb-4">Showing the ${nearest.length} closest providers to ${zip}:</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          ${nearest.map(({ provider, distance }) => renderCard(provider, distance)).join('')}
        </div>
      `;
    } catch {
      showError('Something went wrong loading provider data. Please try again.');
    } finally {
      btn.disabled = false;
      btn.textContent = originalLabel;
    }
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const zip = input.value.trim();
    if (!/^\d{5}$/.test(zip)) {
      showError('Please enter a valid 5-digit ZIP code.');
      return;
    }

    await runSearch(zip);
  });

  certFilter?.addEventListener('change', async () => {
    if (lastSearchedZip) {
      await runSearch(lastSearchedZip);
    }
  });
</script>
