---
import citiesData from '../../../data/cities.json';
import providersData from '../../../../providers.json';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return citiesData.states.map((state) => ({
    params: { state: state.slug },
    props: { state },
  }));
}

interface Props {
  state: (typeof citiesData.states)[0];
}

const { state } = Astro.props;

const SITE_URL = 'https://www.myhormoneguide.com';

const breadcrumbs = [
  { label: 'Find a Provider', href: '/find-bhrt-provider/' },
  { label: state.name, href: `/find-bhrt-provider/${state.slug}/` },
];

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL },
    { '@type': 'ListItem', position: 2, name: 'Find a Provider', item: `${SITE_URL}/find-bhrt-provider/` },
    { '@type': 'ListItem', position: 3, name: state.name, item: `${SITE_URL}/find-bhrt-provider/${state.slug}/` },
  ],
};

const primaryCities = state.cities.filter((c) => c.tier === 'primary');
const secondaryCities = state.cities.filter((c) => c.tier === 'secondary');

// Cities with real provider data that aren't part of the curated cities.json
// list — grouped straight from providers.json so every one of the 2,796
// profile pages is reachable from somewhere, not just the curated cities.
const curatedCityKeys = new Set(state.cities.map((c) => c.name.trim().toLowerCase()));

const additionalCityGroups = new Map<string, { name: string; providers: (typeof providersData)[0][] }>();
for (const provider of providersData) {
  if (provider.stateCode !== state.abbr) continue;
  const key = provider.city.trim().toLowerCase();
  if (!key || curatedCityKeys.has(key)) continue;
  if (!additionalCityGroups.has(key)) {
    additionalCityGroups.set(key, { name: provider.city.trim(), providers: [] });
  }
  additionalCityGroups.get(key)!.providers.push(provider);
}

const additionalCities = [...additionalCityGroups.values()].sort((a, b) => a.name.localeCompare(b.name));

// Total cities actually rendered on this page — curated (primary + secondary)
// plus the provider-derived "More Cities" list. Compute from the real lists
// being shown, not from state.cities.length, so the count can't drift from
// what's on the page.
const totalCitiesShown = primaryCities.length + secondaryCities.length + additionalCities.length;
---

<BaseLayout
  title={`BHRT Providers in ${state.name} — MyHormoneGuide`}
  description={`Find bioidentical hormone replacement therapy providers across ${state.name}. Browse cities with verified BHRT clinics, pellet therapy specialists, and hormone optimization doctors.`}
  breadcrumbs={breadcrumbs}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </Fragment>

  <!-- Header -->
  <div class="bg-gradient-to-br from-navy-600 to-navy-700 py-14">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <a href="/find-bhrt-provider/" class="inline-flex items-center gap-1 text-navy-200 hover:text-white text-sm mb-4 transition-colors">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        Find a Provider
      </a>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white mb-4">
        BHRT Providers in {state.name}
      </h1>
      <p class="text-navy-100 text-lg leading-relaxed max-w-2xl">
        Browse {totalCitiesShown} {totalCitiesShown === 1 ? 'city' : 'cities'} across {state.name} with bioidentical hormone replacement therapy providers. Select a city to find local specialists.
      </p>
    </div>
  </div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">

    <!-- Primary cities -->
    {primaryCities.length > 0 && (
      <section aria-labelledby="primary-heading" class="mb-12">
        <h2 id="primary-heading" class="text-xl font-bold text-navy-700 mb-5">Major Cities</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {primaryCities.map((city) => (
            <a
              href={`/find-bhrt-provider/${state.slug}/${city.slug}/`}
              class="group flex items-center justify-between p-5 bg-white border border-navy-100 rounded-2xl hover:border-teal-300 hover:shadow-md transition-all duration-200"
            >
              <div>
                <p class="font-semibold text-navy-700 group-hover:text-teal-600 transition-colors">{city.name}</p>
                <p class="text-sm text-gray-400 mt-0.5">{state.name}</p>
              </div>
              <svg class="w-5 h-5 text-navy-300 group-hover:text-teal-400 group-hover:translate-x-1 transition-all flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Secondary cities -->
    {secondaryCities.length > 0 && (
      <section aria-labelledby="secondary-heading">
        <h2 id="secondary-heading" class="text-xl font-bold text-navy-700 mb-5">Additional Cities</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {secondaryCities.map((city) => (
            <a
              href={`/find-bhrt-provider/${state.slug}/${city.slug}/`}
              class="group flex items-center justify-between p-5 bg-white border border-navy-100 rounded-2xl hover:border-teal-300 hover:shadow-sm transition-all duration-200"
            >
              <div>
                <p class="font-semibold text-navy-700 group-hover:text-teal-600 transition-colors">{city.name}</p>
                <p class="text-sm text-gray-400 mt-0.5">{state.name}</p>
              </div>
              <svg class="w-5 h-5 text-navy-300 group-hover:text-teal-400 group-hover:translate-x-1 transition-all flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Additional cities from provider data (not yet curated full city pages) -->
    {additionalCities.length > 0 && (
      <section aria-labelledby="more-cities-heading" class="mb-12">
        <h2 id="more-cities-heading" class="text-xl font-bold text-navy-700 mb-2">More Cities with Providers</h2>
        <p class="text-sm text-gray-500 mb-5">
          Additional {state.name} cities with EvexiPEL-certified providers.
        </p>
        <div class="space-y-3">
          {additionalCities.map((cityGroup) => (
            cityGroup.providers.length === 1 ? (
              <a
                href={`/provider/${cityGroup.providers[0].slug}/`}
                class="group flex items-center justify-between p-4 bg-white border border-navy-100 rounded-xl hover:border-teal-300 hover:shadow-sm transition-all duration-200"
              >
                <div>
                  <p class="font-semibold text-navy-700 group-hover:text-teal-600 transition-colors">{cityGroup.name}</p>
                  <p class="text-xs text-gray-400 mt-0.5">{cityGroup.providers[0].practiceName}</p>
                </div>
                <svg class="w-4 h-4 text-navy-300 group-hover:text-teal-400 group-hover:translate-x-1 transition-all flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </a>
            ) : (
              <details class="group bg-white border border-navy-100 rounded-xl overflow-hidden">
                <summary class="flex items-center justify-between gap-4 p-4 cursor-pointer list-none">
                  <span class="font-semibold text-navy-700 group-hover:text-teal-600 transition-colors">
                    {cityGroup.name}
                    <span class="text-gray-400 font-normal text-sm ml-1">({cityGroup.providers.length} providers)</span>
                  </span>
                  <svg class="w-4 h-4 text-navy-300 flex-shrink-0 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                  </svg>
                </summary>
                <div class="px-4 pb-4 pt-1 border-t border-navy-50 space-y-2">
                  {cityGroup.providers.map((provider) => (
                    <a href={`/provider/${provider.slug}/`} class="flex items-center gap-1.5 text-sm text-teal-600 hover:text-teal-500 font-medium">
                      {provider.practiceName}
                      <svg class="w-3 h-3 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                      </svg>
                    </a>
                  ))}
                </div>
              </details>
            )
          ))}
        </div>
      </section>
    )}

    <!-- Back link -->
    <div class="mt-12 pt-8 border-t border-gray-100">
      <a href="/find-bhrt-provider/" class="inline-flex items-center gap-2 text-sm text-teal-600 hover:text-teal-500 font-medium">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        View all states
      </a>
    </div>

  </div>
</BaseLayout>
